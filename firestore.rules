rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'niagakoin.official@gmail.com',
          'deddy.mujahidin07@gmail.com',
          'dedi.mujahidin00@gmail.com'
        ];
    }

    function isUserOwnedDocument(userId) {
      return isOwner(userId) && request.resource.data.userId == userId;
    }

    function currentMemberId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberId;
    }

    function hasOnlyPublicMemberFields() {
      return request.resource.data.keys().hasOnly([
        'memberId',
        'userId',
        'username',
        'accountStatus',
        'emailMasked',
        'sponsorId',
        'sponsorName',
        'joinedAt'
      ]);
    }

    function hasNoPrivateMemberFields() {
      return !resource.data.keys().hasAny([
        'emailFull',
        'liquidBalance',
        'gasReserve',
        'depositAddress',
        'role'
      ]);
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /system/member_id_counter {
      allow get: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['value'])
        && request.resource.data.value is int
        && request.resource.data.value > 0
        && getAfter(/databases/$(database)/documents/member_id_reservations/$(request.auth.uid)).data.sequence == request.resource.data.value;
      allow update: if isSignedIn()
        && request.resource.data.keys().hasOnly(['value'])
        && request.resource.data.value == resource.data.value + 1
        && getAfter(/databases/$(database)/documents/member_id_reservations/$(request.auth.uid)).data.sequence == request.resource.data.value;
      allow list, delete: if false;
    }

    match /member_id_reservations/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['userId', 'memberId', 'sequence', 'createdAt'])
        && request.resource.data.userId == userId
        && request.resource.data.memberId is string
        && request.resource.data.memberId.matches('GN-[0-9]{5}')
        && request.resource.data.sequence is int
        && !exists(/databases/$(database)/documents/member_directory/$(request.resource.data.memberId));
      allow update, delete: if false;
    }

    match /member_id_index/{memberId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.keys().hasOnly(['userId', 'memberId', 'sequence'])
        && request.resource.data.memberId == memberId
        && request.resource.data.memberId.matches('GN-[0-9]{5}')
        && request.resource.data.sequence is int
        && getAfter(/databases/$(database)/documents/member_id_reservations/$(request.resource.data.userId)).data.memberId == memberId
        && !exists(/databases/$(database)/documents/member_id_index/$(memberId));
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.memberId is string
        && request.resource.data.memberId.matches('GN-[0-9]{5}')
        && get(/databases/$(database)/documents/member_id_reservations/$(userId)).data.memberId == request.resource.data.memberId
        && get(/databases/$(database)/documents/member_id_index/$(request.resource.data.memberId)).data.userId == userId;
      allow update: if isOwner(userId)
        && request.resource.data.id == userId
        && (request.resource.data.memberId == resource.data.memberId
          || ((!resource.data.keys().hasAny(['memberId'])
            || !(resource.data.memberId is string)
            || !resource.data.memberId.matches('GN-[0-9]{5}'))
            && get(/databases/$(database)/documents/member_id_reservations/$(userId)).data.memberId == request.resource.data.memberId));
      allow delete: if isAdmin();

      match /positions/{positionId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isUserOwnedDocument(userId) && request.resource.data.userId == userId;
        allow update: if isUserOwnedDocument(userId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isUserOwnedDocument(userId) && request.resource.data.userId == userId;
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }

      match /trade_history/{tradeId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isUserOwnedDocument(userId) && request.resource.data.userId == userId;
        allow update: if isUserOwnedDocument(userId) && request.resource.data.userId == userId;
        allow delete: if isAdmin();
      }

      match /network/{networkId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isUserOwnedDocument(userId) && request.resource.data.userId == userId;
        allow update: if isUserOwnedDocument(userId) && request.resource.data.userId == userId;
        allow delete: if isAdmin();
      }

      match /price_alerts/{alertId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isUserOwnedDocument(userId) && request.resource.data.userId == userId;
        allow update: if isUserOwnedDocument(userId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /wallet_ledger/{entryId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /member_directory/{memberId} {
      allow get: if isSignedIn() && hasNoPrivateMemberFields();
      allow list: if (isAdmin()
        || (isSignedIn() && resource.data.sponsorId == currentMemberId()))
        && hasNoPrivateMemberFields();
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.memberId == memberId
        && (get(/databases/$(database)/documents/member_id_reservations/$(request.resource.data.userId)).data.memberId == memberId
          || get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.memberId == memberId)
        && hasOnlyPublicMemberFields();
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.memberId == memberId
        && hasOnlyPublicMemberFields();
      allow delete: if isAdmin();
    }
  }
}
