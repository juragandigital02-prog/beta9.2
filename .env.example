# GEMINI_API_KEY: Opsional / Diperlukan jika menggunakan fitur Gemini AI
GEMINI_API_KEY=""

# APP_URL: URL aplikasi (default lokal: http://localhost:3000)
APP_URL="http://localhost:3000"

# PORT: Port server Express & Vite (default: 3000)
PORT=3000

# Production browser origins, comma-separated exact origins; never use wildcards.
CORS_ALLOWED_ORIGINS="https://app.example.com"

# Firebase Admin SDK uses Application Default Credentials (ADC).
# Local: run `gcloud auth application-default login` with Firestore access.
# Production: use workload identity or inject GOOGLE_APPLICATION_CREDENTIALS securely.
# Only set true when the deployment injects a custom ADC source not detected above.
FIREBASE_ADMIN_ENABLED=false

